{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "headers": [
    {
      "source": "/sw.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        },
        {
          "key": "Service-Worker-Allowed",
          "value": "/"
        }
      ]
    },
    {
      "source": "/manifest.webmanifest",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/manifest+json"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/healthz",
      "destination": "/api"
    },
    {
      "source": "/api/:match*",
      "destination": "/api"
    },
    {
      "source": "/((?!api|healthz|sw\\.js|workbox-.*|assets|manifest\\.webmanifest|registerSW\\.js|favicon\\.ico).*)*",
      "destination": "/index.html"
    }
  ]
}
