# Server only. Use a pooled PostgreSQL connection for Vercel serverless workers.
# Supply real values through the process environment or hosting secret settings.
DATABASE_URL=postgresql://username:password@database-host:5432/database-name?sslmode=verify-full
# Generate a random value: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# Optional AI provider key (never VITE_ prefix).
GEMINI_API_KEY=
# Explicit, disposable local database for npm run test:postgres. Never production.
TEST_DATABASE_URL=
# Optional C021 Supabase Realtime. Server verifies the legacy anon JWT against
# the matching project HS256 JWT secret. New sb_publishable_ keys are not supported
# by this verifier. Never prefix the JWT secret or DATABASE_URL with VITE_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
# Public browser settings: same project URL and legacy anon key, available at build time.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Identity Services web client ID (public identifier, not a secret).
# Configure exact authorized JavaScript origins in Google Cloud Console.
GOOGLE_CLIENT_ID=

# C024 Web Push. Generate a VAPID pair once: npx web-push generate-vapid-keys
# Both keys are base64url; the private key is a server-only secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Must be a mailto: address the push providers can contact about this sender.
VAPID_SUBJECT=mailto:you@example.com
# Authorizes GET /api/cron/expiry. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Set the same value as a Vercel env var named CRON_SECRET; Vercel Cron Jobs then
# send it automatically as "Authorization: Bearer $CRON_SECRET" on every invocation.
CRON_SECRET=

# C025 photo storage. The legacy anon key above cannot access a private Storage bucket;
# this must be the project's service_role secret key (Project Settings -> API Keys),
# never the anon/publishable key, and never prefixed with VITE_ or sent to the browser.
# Create a PRIVATE bucket named exactly "food-photos" in Supabase Storage before using this.
SUPABASE_SERVICE_ROLE_KEY=
