        "summary": "Register push notification subscription",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "room_code": {
                    "type": "string"
                  },
                  "subscription": {
                    "type": "object"
                  },
                  "device_name": {
                    "type": "string"
                  }
                },
                "required": [
                  "room_code",
                  "subscription"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "subscriber_id": {
                      "type": "string"
                    }
                  }
                }
              }
            },
            "description": "Success"
          },
          "400": {
            "description": "Invalid JSON or input",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, malformed or expired session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Session belongs to a different room",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Resource absent or belongs to another room",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "500": {
            "description": "Internal error; no sensitive details",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        },
        "security": [
          {
            "RoomBearer": []
          }
        ]
      }
    },
    "/api/auth/create-room": {
      "post": {
        "summary": "Create a password-protected room and issue a session",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoomCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials or session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Session service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Room code already exists; never overwritten",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/join-room": {
      "post": {
        "summary": "Join a room using its PIN",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RoomJoin"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthSession"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials or session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Session service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/verify-token": {
      "post": {
        "summary": "Verify session and return only public room fields",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "token"
                ],
                "properties": {
                  "token": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "valid",
                    "payload",
                    "room"
                  ],
                  "properties": {
                    "valid": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    },
                    "payload": {
                      "$ref": "#/components/schemas/SessionPayload"
                    },
                    "room": {
                      "$ref": "#/components/schemas/Room"
                    }
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Invalid credentials or session",
            "content": {
              "application/json": {
                "schema": {
                  "allOf": [
                    {
                      "$ref": "#/components/schemas/Error"
                    },
                    {
                      "type": "object",
                      "required": [
                        "valid"
                      ],
                      "properties": {
                        "valid": {
                          "type": "boolean",
                          "enum": [
                            false
                          ]
                        }
                      }
                    }
                  ]
                }
              }
            }
          },
          "429": {
            "description": "Too many attempts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Session service unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Room": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "code",
          "name",
          "created_at"
        ]
      },
      "RoomDetail": {
        "allOf": [
          {
            "$ref": "#/components/schemas/Room"
          },
          {
            "type": "object",
            "properties": {
              "active_food_count": {
                "type": "integer"
              },
              "urgent_food_count": {
                "type": "integer"
              }
            }
          }
        ]
      },
      "FoodItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "room_code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "compartment": {
            "type": "string",
            "enum": [
              "FREEZER",
              "FRIDGE_TOP",
              "FRIDGE_BOTTOM",
              "CRISPER",
              "DOOR"
            ]
          },
          "container_tag": {
            "type": "string"
          },
          "added_date": {
            "type": "string"
          },
          "expiry_date": {
            "type": "string"
          },
          "days_remaining": {
            "type": "number"
          },
          "status": {
            "type": "string",
            "enum": [
              "FRESH",
              "COOK_SOON",
              "EXPIRED",
              "CONSUMED"
            ]
          },
          "photo_url": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "created_by": {
            "type": "string",
            "description": "Derived from the verified room session; client value ignored."
          },
          "consumed_by": {
            "type": "string",
            "nullable": true,
            "description": "Derived from the verified room session."
          },
          "consumed_at": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          }
        },
        "required": [
          "id",
          "room_code",
          "name",
          "compartment",
          "added_date",
          "expiry_date",
          "days_remaining",
          "status"
        ]
      },
      "CreateFoodDto": {
        "type": "object",
        "properties": {
          "room_code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "compartment": {
            "type": "string",
            "enum": [
              "FREEZER",
              "FRIDGE_TOP",
              "FRIDGE_BOTTOM",
              "CRISPER",
              "DOOR"
            ]
          },
          "container_tag": {
            "type": "string"
          },
          "shelf_life_days": {
            "type": "number"
          },
          "photo_url": {
            "type": "string",
            "nullable": true
          },
          "notes": {
            "type": "string",
            "nullable": true
          },
          "created_by": {
            "type": "string"
          }
        },
        "required": [
          "room_code",
          "name",
          "compartment",
          "shelf_life_days"
        ]
      },
      "ParsedFoodItem": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "compartment": {
            "type": "string"
          },
          "container_tag": {
            "type": "string"
          },
          "shelf_life_days": {
            "type": "number"
          }
        },
        "required": [
          "name",
          "compartment",
          "shelf_life_days"
        ]
      },
      "RecipeSuggestion": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "cook_time_minutes": {
            "type": "integer"
          },
          "ingredients_used": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "ingredients_missing": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "instructions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "title",
          "cook_time_minutes",
          "ingredients_used",
          "instructions"
        ]
      },
      "ShoppingItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "room_code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          },
          "is_bought": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "room_code",
          "name",
          "is_bought",
          "created_at"
        ]
      },
      "CreateShoppingItemDto": {
        "type": "object",
        "properties": {
          "room_code": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "quantity": {
            "type": "string"
          }
        },
        "required": [
          "room_code",
          "name"
        ]
      },
      "Error": {
        "type": "object",
        "required": [
          "error",
          "code"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string"
          }
        }
      },
      "RoomCreate": {
        "type": "object",
        "required": [
          "passcode"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "passcode": {
            "type": "string",
            "pattern": "^[0-9]{4,6}$",
            "writeOnly": true
          },
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "RoomJoin": {
        "type": "object",
        "required": [
          "code",
          "passcode"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "passcode": {
            "type": "string",
            "pattern": "^[0-9]{4,6}$",
            "writeOnly": true
          },
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          }
        }
      },
      "SessionPayload": {
        "type": "object",
        "required": [
          "room_code",
          "nickname",
          "exp"
        ],
        "properties": {
          "room_code": {
            "type": "string",
            "pattern": "^[0-9]{6}$"
          },
          "nickname": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "exp": {
            "type": "integer",
            "description": "Expiry as Unix epoch milliseconds; mandatory and strictly in the future."
          }
        }
      },
      "AuthSession": {
        "type": "object",
        "required": [
          "room",
          "token",
          "nickname"
        ],
        "properties": {
          "room": {
            "$ref": "#/components/schemas/Room"
          },
          "token": {
            "type": "string"
          },
          "nickname": {
            "type": "string"
          }
        }
      }
    },
    "securitySchemes": {
      "RoomBearer": {
        "type": "http",
        "scheme": "bearer",
        "description": "Room session from create-room or join-room; signature, mandatory expiry and room existence checked on every protected request."
      }
    }
  }
}
